generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

enum AgeGroup {
  TODDLER
  KIDS
  YOUTH
  ADULT
  ALL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PatternType {
  SOLID
  PRINT
  STRIPE
  MIXED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  READY
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_DELIVERY
  BUY_X_GET_Y
}

enum DiscountScope {
  ORDER
  PRODUCT
  CATEGORY
  COLLECTION
  BUNDLE
}

enum SeasonKey {
  SUMMER
  SPRING
  AUTUMN
  WINTER
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  PAUSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
  auditLogs    AuditLog[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  firstName  String
  lastName   String
  phone      String
  line1      String
  line2      String?
  suburb     String
  city       String
  province   String
  postalCode String
  isDefault  Boolean @default(false)
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  products    Product[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  ageGroup    AgeGroup   @default(ALL)
  sortOrder   Int        @default(0)
  products    Product[]
}

model Collection {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  imageUrl    String?
  ageGroup    AgeGroup             @default(ALL)
  featured    Boolean              @default(false)
  homepage    Boolean              @default(false)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String
  material        String?
  care            String?
  brandId         String
  brand           Brand               @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id])
  ageGroup        AgeGroup            @default(KIDS)
  pattern         PatternType         @default(SOLID)
  status          ProductStatus       @default(ACTIVE)
  featured        Boolean             @default(false)
  clearance       Boolean             @default(false)
  listedAt        DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  images          ProductImage[]
  variants        Variant[]
  collections     CollectionProduct[]
  reviews         Review[]
  wishlist        WishlistItem[]
  bundleItems     BundleProduct[]
  campaignItems   CampaignProduct[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model SizeDefinition {
  id        String  @id @default(cuid())
  name      String
  ageLabel  String
  waistMin  Int?
  waistMax  Int?
  sortOrder Int     @default(0)
  variants  Variant[]
}

model Variant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique
  colorName      String
  colorHex       String
  sizeId         String
  size           SizeDefinition @relation(fields: [sizeId], references: [id])
  priceCents     Int
  compareAtCents Int?
  stock          Int            @default(0)
  reserved       Int            @default(0)
  barcode        String?
  lastSoldAt     DateTime?
  unitsSold      Int            @default(0)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  movements      StockMovement[]

  @@unique([productId, colorName, sizeId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  email           String
  phone           String
  firstName       String
  lastName        String
  addressLine1    String
  addressLine2    String?
  suburb          String
  city            String
  province        String
  postalCode      String
  deliveryNotes   String?
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotalCents   Int
  discountCents   Int           @default(0)
  deliveryCents   Int           @default(0)
  totalCents      Int
  couponCode      String?
  discountId      String?
  bundleId        String?
  currency        String        @default("ZAR")
  notes           String?
  reservedUntil   DateTime?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  payments        Payment[]
  events          OrderEvent[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant @relation(fields: [variantId], references: [id])
  productName    String
  colorName      String
  sizeName       String
  sku            String
  quantity       Int
  unitCents      Int
  lineCents      Int
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  actor     String?
  createdAt DateTime @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  providerRef   String?
  webhookId     String?       @unique
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  rawPayload    String?
  createdAt     DateTime      @default(now())
}

model Discount {
  id              String        @id @default(cuid())
  name            String
  code            String?       @unique
  type            DiscountType
  scope           DiscountScope @default(ORDER)
  percentOff      Int?
  amountCents     Int?
  buyQuantity     Int?
  getQuantity     Int?
  minSpendCents   Int?
  firstOrderOnly  Boolean       @default(false)
  automatic       Boolean       @default(false)
  freeDelivery    Boolean       @default(false)
  usageLimit      Int?
  usageCount      Int           @default(0)
  perCustomerLimit Int?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean       @default(true)
  productIds      String?
  collectionIds   String?
  categoryIds     String?
  revenueCents    Int           @default(0)
  ordersCount     Int           @default(0)
  savingsCents    Int           @default(0)
  createdAt       DateTime      @default(now())
}

model Bundle {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  pickCount     Int
  priceCents    Int
  homepage      Boolean         @default(true)
  active        Boolean         @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  campaignName  String?
  createdAt     DateTime        @default(now())
  products      BundleProduct[]
}

model BundleProduct {
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

model Campaign {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  description  String?
  heroUrl      String?
  bannerText   String?
  season       SeasonKey?
  discountId   String?
  homepage     Boolean           @default(false)
  status       CampaignStatus    @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime          @default(now())
  products     CampaignProduct[]
}

model CampaignProduct {
  campaignId String
  productId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

model Theme {
  id             String    @id @default(cuid())
  season         SeasonKey
  label          String
  primary        String
  secondary      String
  accent         String
  background     String
  foreground     String
  muted          String
  heroHeading    String
  heroSubtitle   String
  ctaPrimary     String
  ctaSecondary   String
  bannerText     String
  heroImage      String?
  campaignImage  String?
  heroVideo      String?
  decorative     String?
  published      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ThemeSnapshot {
  id        String   @id @default(cuid())
  payload   String
  createdAt DateTime @default(now())
}

model ContentPage {
  key       String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model Review {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  author      String
  rating      Int
  body        String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StockMovement {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  delta     Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  orderId   String?
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}
