# Copy to .env.local. Never commit secrets.

# SQLite for local development (zero config)
DATABASE_URL="file:./dev.db"

# For production Postgres (Neon or any Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Then change prisma/schema.prisma datasource provider to "postgresql"

AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded owner. Change immediately after first login.
ADMIN_EMAIL="owner@understood.co.za"
ADMIN_PASSWORD="UnderstoodLaunch1!"
OWNER_EMAIL="owner@understood.co.za"

# Payment provider: manual | yoco | stripe
PAYMENT_PROVIDER="manual"

# Yoco (South Africa). Secret keys stay on the server.
YOCO_SECRET_KEY=""
YOCO_WEBHOOK_SECRET=""
YOCO_MODE="test"
NEXT_PUBLIC_YOCO_PUBLIC_KEY=""

# Optional Stripe adapter
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend. If empty, emails are logged only.
RESEND_API_KEY=""
EMAIL_FROM="UNDERSTOOD. <orders@yourdomain.co.za>"

# Optional WhatsApp number in international format, e.g. 27821234567
WHATSAPP_NUMBER=""
